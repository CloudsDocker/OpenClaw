# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Generate a strong gateway token:
#   openssl rand -hex 24

OPENCLAW_GATEWAY_TOKEN=change_me_use_openssl_rand_hex_24

# Optional: enable web search via Brave Search API
# Get a free API key at https://brave.com/search/api/
# Free tier: 2,000 queries/month
BRAVE_API_KEY=

# Optional: Telegram Bot for mobile control
# Create a bot via @BotFather, get your user ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Optional: GitHub integration — create PRs and draft team messages via Telegram
# PAT needs "repo" scope; if org uses SSO authorise it for your org too
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-repo
GITHUB_USERNAME=your-github-username
GITHUB_BASE_BRANCH=master
